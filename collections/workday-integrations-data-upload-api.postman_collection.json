                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datasetId",
                  "description": "(Required) Workday ID of the Prism Analytics dataset"
                },
                {
                  "description": "Workday tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
