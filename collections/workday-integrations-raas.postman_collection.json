    {
      "id": "11485ed5-3b06-41f2-88ad-c9ce63dcaa72",
      "name": "Reports",
      "description": {
        "content": "Access custom and standard Workday reports",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "25b4e01f-0930-4b54-8c41-ffe7c67a872a",
          "name": "Workday Integrations Get report data",
          "request": {
            "name": "Workday Integrations Get report data",
            "description": {
              "content": "Execute a Workday custom report and retrieve its data. The report must have web service enabled. Returns data in JSON format by default, with support for CSV and XML via the format parameter. Supports prompt-based filtering through query parameters matching report prompt names.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":reportOwner",
                ":reportName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format for the report data"
                },
                {
                  "disabled": false,
                  "key": "Employee_ID",
                  "value": "<string>",
                  "description": "Filter by Employee ID (example prompt parameter; actual parameters depend on report configuration)"
                },
                {
                  "disabled": false,
                  "key": "Effective_Date",
                  "value": "<date>",
                  "description": "Filter by effective date in YYYY-MM-DD format (example prompt parameter)"
                },
                {
                  "disabled": false,
                  "key": "Organization",
                  "value": "<string>",
                  "description": "Filter by organization WID or reference ID (example prompt parameter)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of rows to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of rows to skip for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportOwner",
                  "description": "(Required) Username of the report owner in Workday (the ISU account or integration system user that owns the report)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportName",
                  "description": "(Required) Name of the custom report as defined in Workday. Must match the report name exactly, using underscores for spaces."
                },
                {
                  "description": "Workday tenant name",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
