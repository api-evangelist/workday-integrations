{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Integrations Workday Prism Analytics Benefits Time Off API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Time Off",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Workday Integrations Get worker time off plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/prismAnalytics/v2/{tenant}/workers/:workerId/timeOffPlans",
            "params": [
              {
                "name": "workerId",
                "value": "",
                "type": "path",
                "description": "Workday ID of the worker"
              }
            ]
          },
          "docs": "Retrieve time off plans and balances for a specific worker, including accrued, used, and available balances."
        }
      ]
    }
  ],
  "bundled": true
}